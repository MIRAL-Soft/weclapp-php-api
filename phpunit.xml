<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd" bootstrap="vendor/autoload.php" colors="true" defaultTestSuite="Unit">
  <testsuites>
    <testsuite name="Unit">
      <directory>tests/Unit</directory>
    </testsuite>
    <testsuite name="Integration">
      <directory>tests/Integration</directory>
    </testsuite>
    <!-- "Write" is a convenience alias that runs only the write-enabled integration tests.
         These tests actually create and delete records in the live tenant.
         Requires: WECLAPP_TENANT, WECLAPP_TOKEN, and WECLAPP_ALLOW_WRITES=true -->
    <testsuite name="Write">
      <file>tests/Integration/Resource/WebhookWriteIntegrationTest.php</file>
    </testsuite>
  </testsuites>
  <php>
    <ini name="error_reporting" value="-1"/>
  </php>
  <source>
    <include>
      <directory>src</directory>
    </include>
    <exclude>
      <directory>src/Config.php</directory>
      <directory>src/APICall.php</directory>
      <directory>src/WeclappAPICall.php</directory>
    </exclude>
  </source>
</phpunit>
