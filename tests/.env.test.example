# weclapp Integration-Test credentials
# ─────────────────────────────────────
# Copy this file to tests/.env.test and fill in your values.
# tests/.env.test is gitignored — never commit real credentials.
#
# ── Running tests ────────────────────────────────────────────────────────────
#
#   Unit only (default, no credentials needed):
#     php vendor/bin/phpunit
#
#   Read-only integration tests (safe against any tenant):
#     php vendor/bin/phpunit --testsuite Integration
#
#   Write integration tests (creates + deletes real records, opt-in):
#     php vendor/bin/phpunit --testsuite Write
#
# ── Required for all integration tests ───────────────────────────────────────

# Your weclapp tenant subdomain.
# For https://miralsoft.weclapp.com use: miralsoft
WECLAPP_TENANT=your-tenant

# API token — found in weclapp → Settings → API → Token
WECLAPP_TOKEN=your-api-token-here

# ── Optional: test-data anchors ───────────────────────────────────────────────
#
# A dedicated test customer (internal weclapp ID, not customerNumber).
# When set, dry-run and write tests use this customer instead of picking
# the first one from the list — makes tests more deterministic.
# WECLAPP_TEST_CUSTOMER_ID=12345

# ── Opt-in: write tests ───────────────────────────────────────────────────────
#
# Set to true to enable tests that create/update/delete real records.
# All write tests clean up after themselves (try/finally).
# WECLAPP_ALLOW_WRITES=true
