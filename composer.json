{
  "name": "miralsoft/weclapp-api",
  "description": "PHP client library for the weclapp REST API v2. Provides a clean, typed interface for customers, contacts, articles, orders, invoices, quotations and webhooks.",
  "type": "library",
  "minimum-stability": "stable",
  "license": "proprietary",
  "authors": [
    {
      "name": "Michael Tosch",
      "email": "m.tosch@miralsoft.com",
      "role": "Software Engineer"
    }
  ],
  "require": {
    "php": "^8.3",
    "guzzlehttp/guzzle": "^7.8",
    "psr/http-client": "^1.0",
    "psr/log": "^3.0",
    "psr/simple-cache": "^3.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "miralsoft\\weclapp\\api\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "miralsoft\\weclapp\\api\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --testsuite Unit",
    "analyse": "phpstan analyse",
    "spec:update": "php bin/update-openapi-spec.php"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
